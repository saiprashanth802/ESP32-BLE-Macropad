<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyTitle>MacroPad Deck</AssemblyTitle>
    <ApplicationIcon>deck.ico</ApplicationIcon>
    <!-- single-file publish: dotnet publish -r win-x64 -p:PublishSingleFile=true (self-contained) -->
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="deck.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MacroPadDeck.Core\MacroPadDeck.Core.csproj" />
  </ItemGroup>

</Project>
