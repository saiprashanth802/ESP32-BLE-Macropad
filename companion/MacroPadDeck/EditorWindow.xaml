<Window x:Class="MacroPadDeck.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MacroPad Deck" Width="980" Height="660" MinWidth="880" MinHeight="580"
        Background="#FAF9F5" FontFamily="Segoe UI" FontSize="13" Icon="deck.ico"
        WindowStartupLocation="CenterScreen" SnapsToDevicePixels="True"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

  <Window.Resources>
    <!-- Colours are declared before the brushes and both forms derive from them: the
         hover storyboards animate Color, not Brush, so without this the accent forks
         into four literal hexes that drift apart on the first tweak. -->
    <Color x:Key="AccentC">#FFD97757</Color>
    <Color x:Key="AccentDC">#FFC15F3C</Color>
    <Color x:Key="SurfaceC">#FFF0EEE5</Color>
    <Color x:Key="SurfaceC0">#00F0EEE5</Color>
    <Color x:Key="RowHoverC">#FFE8E4D8</Color>
    <Color x:Key="RowHoverC0">#00E8E4D8</Color>

    <SolidColorBrush x:Key="Ink"     Color="#141413"/>
    <!-- Muted was #87867F: 3.15:1 on the #F0EEE5 card, which fails WCAG AA and was
         being used at 11px. #6B6A63 is 4.67:1 against the same background. -->
    <SolidColorBrush x:Key="Muted"   Color="#6B6A63"/>
    <SolidColorBrush x:Key="Surface" Color="{StaticResource SurfaceC}"/>
    <SolidColorBrush x:Key="Border2" Color="#DAD5C9"/>
    <SolidColorBrush x:Key="Accent"  Color="{StaticResource AccentC}"/>

    <!-- One grouping device per level. Cards were fill + hairline border + shadow,
         three devices doing one job, and then bordered tiles nested inside them.
         Fill + shadow only; the border budget is spent on selection instead. -->
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Surface}"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Effect">
        <Setter.Value>
          <DropShadowEffect BlurRadius="20" ShadowDepth="2" Direction="270"
                            Color="#141413" Opacity="0.06"/>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Type scale is 20 / 15 / 13 / 11 and nothing in between. It was six sizes
         (10.5 11 11.5 13 15 17) inside a 1.6:1 range, which reads as one grey mass. -->
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    </Style>
    <Style x:Key="MutedText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>
    <Style x:Key="SectionLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,16,0,6"/>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Border2}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="{StaticResource Border2}"/>
    </Style>

    <!-- Hover is a 120 ms colour ramp rather than an instant snap. The template Border
         carries its own SolidColorBrush instance (not the shared StaticResource, which
         is frozen and would throw when animated). -->
    <Style x:Key="PrimaryBtn" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="18,9"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" CornerRadius="10" Padding="{TemplateBinding Padding}">
              <Border.Background>
                <SolidColorBrush Color="{StaticResource AccentC}"/>
              </Border.Background>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <EventTrigger RoutedEvent="MouseEnter">
                <BeginStoryboard>
                  <Storyboard>
                    <ColorAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="Background.Color"
                                    To="{StaticResource AccentDC}" Duration="0:0:0.12"/>
                  </Storyboard>
                </BeginStoryboard>
              </EventTrigger>
              <EventTrigger RoutedEvent="MouseLeave">
                <BeginStoryboard>
                  <Storyboard>
                    <ColorAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="Background.Color"
                                    To="{StaticResource AccentC}" Duration="0:0:0.12"/>
                  </Storyboard>
                </BeginStoryboard>
              </EventTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Ghost hover fades alpha on one hue (#00F0EEE5 → #FFF0EEE5) so the ramp never
         passes through a grey midpoint the way Transparent → Surface would. -->
    <Style x:Key="GhostBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" CornerRadius="10"
                    BorderBrush="{StaticResource Border2}" BorderThickness="1"
                    Padding="{TemplateBinding Padding}">
              <Border.Background>
                <SolidColorBrush Color="{StaticResource SurfaceC0}"/>
              </Border.Background>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <EventTrigger RoutedEvent="MouseEnter">
                <BeginStoryboard>
                  <Storyboard>
                    <ColorAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="Background.Color"
                                    To="{StaticResource SurfaceC}" Duration="0:0:0.12"/>
                  </Storyboard>
                </BeginStoryboard>
              </EventTrigger>
              <EventTrigger RoutedEvent="MouseLeave">
                <BeginStoryboard>
                  <Storyboard>
                    <ColorAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="Background.Color"
                                    To="{StaticResource SurfaceC0}" Duration="0:0:0.12"/>
                  </Storyboard>
                </BeginStoryboard>
              </EventTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="225"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="300"/>
    </Grid.ColumnDefinitions>

    <!-- ── Profiles column ─────────────────────── -->
    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}" Padding="16" Margin="0,0,12,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Text="MacroPad Deck" FontSize="20" FontWeight="SemiBold"/>
          <TextBlock x:Name="LinkStatus" Style="{StaticResource MutedText}" Text="● connecting…" Margin="0,4,0,12"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
          <TextBlock Style="{StaticResource SectionLabel}" Text="EYE COLOR"/>
          <StackPanel Orientation="Horizontal">
            <ItemsControl x:Name="EyeSwatches">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <TextBox x:Name="EyeColorBox" Width="80" TextChanged="EyeColor_Changed"/>
            <Button x:Name="EyePresetBtn" Style="{StaticResource GhostBtn}" Content="match preset"
                    Padding="10,6" Margin="6,0,0,0" Click="EyePreset_Click"/>
          </StackPanel>
          <Button x:Name="AddProfileBtn" Style="{StaticResource GhostBtn}"
                  Content="+ Add profile" Margin="0,12,0,0" Click="AddProfile_Click"/>
        </StackPanel>
        <ListBox x:Name="ProfileList" Background="Transparent" BorderThickness="0"
                 SelectionChanged="ProfileList_SelectionChanged" HorizontalContentAlignment="Stretch">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Template">
                <Setter.Value>
                  <!-- Hover and selection live on separate layers on purpose: a
                       storyboard on Background.Color outranks any Setter for the same
                       property, so sharing one Border would leave a hovered row stuck
                       on the hover colour after it was selected. -->
                  <ControlTemplate TargetType="ListBoxItem">
                    <Grid Margin="0,2">
                      <Border x:Name="sel" CornerRadius="10" Background="Transparent"/>
                      <Border x:Name="hov" CornerRadius="10">
                        <Border.Background>
                          <SolidColorBrush Color="{StaticResource RowHoverC0}"/>
                        </Border.Background>
                      </Border>
                      <ContentPresenter Margin="10,8"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="sel" Property="Background" Value="White"/>
                      </Trigger>
                      <EventTrigger RoutedEvent="MouseEnter">
                        <BeginStoryboard>
                          <Storyboard>
                            <ColorAnimation Storyboard.TargetName="hov" Storyboard.TargetProperty="Background.Color"
                                            To="{StaticResource RowHoverC}" Duration="0:0:0.12"/>
                          </Storyboard>
                        </BeginStoryboard>
                      </EventTrigger>
                      <EventTrigger RoutedEvent="MouseLeave">
                        <BeginStoryboard>
                          <Storyboard>
                            <ColorAnimation Storyboard.TargetName="hov" Storyboard.TargetProperty="Background.Color"
                                            To="{StaticResource RowHoverC0}" Duration="0:0:0.12"/>
                          </Storyboard>
                        </BeginStoryboard>
                      </EventTrigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- ── Key grid ────────────────────────────── -->
    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Card}" Padding="16" Margin="0,0,12,0">
      <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Style="{StaticResource SectionLabel}" Text="PROFILE NAME" Margin="0,0,0,4"/>
            <TextBox x:Name="ProfName" Width="180" HorizontalAlignment="Left" TextChanged="Meta_Changed"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
            <StackPanel Margin="0,0,14,0">
              <TextBlock Style="{StaticResource SectionLabel}" Text="PAD PRESET" Margin="0,0,0,4"/>
              <ComboBox x:Name="ProfPreset" Width="70" SelectionChanged="Meta_Changed"/>
            </StackPanel>
            <StackPanel>
              <TextBlock Style="{StaticResource SectionLabel}" Text="EYE / ACCENT COLOR" Margin="0,0,0,4"/>
              <StackPanel Orientation="Horizontal">
                <ItemsControl x:Name="Swatches">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
                <TextBox x:Name="ProfColor" Width="72" Margin="6,0,0,0" TextChanged="Meta_Changed"/>
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </Grid>

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
          <TextBlock Style="{StaticResource SectionLabel}" Text="AUTO-ACTIVATE FOR APPS (comma-separated exe names)" Margin="0,0,0,4"/>
          <TextBox x:Name="ProfApps" TextChanged="Meta_Changed"/>
        </StackPanel>

        <Button DockPanel.Dock="Bottom" x:Name="DeleteProfileBtn" Style="{StaticResource GhostBtn}"
                Content="Delete this profile" HorizontalAlignment="Left" Margin="0,12,0,0"
                Click="DeleteProfile_Click"/>

        <UniformGrid x:Name="KeyGrid" Columns="4" Rows="3"/>
      </DockPanel>
    </Border>

    <!-- ── Binding editor ──────────────────────── -->
    <!-- Scrolls because the section rhythm is now 16px above each label; at MinHeight
         the four labels plus their controls can exceed the card. -->
    <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource Card}" Padding="16">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <TextBlock x:Name="BindTitle" FontSize="15" FontWeight="SemiBold" Text="Select a key"/>
        <TextBlock Style="{StaticResource MutedText}" Text="K9 is the pad's FN key — its tap can still carry an action." Margin="0,4,0,0" TextWrapping="Wrap"/>

        <TextBlock Style="{StaticResource SectionLabel}" Text="ACTION"/>
        <ComboBox x:Name="BindType" SelectionChanged="BindType_Changed">
          <ComboBoxItem Content="None (keep firmware key)"/>
          <ComboBoxItem Content="Focus or launch app"/>
          <ComboBoxItem Content="Open URL / file / folder"/>
          <ComboBoxItem Content="Run command"/>
          <ComboBoxItem Content="Window control"/>
          <ComboBoxItem Content="Keyboard shortcut"/>
          <ComboBoxItem Content="Media key"/>
          <ComboBoxItem Content="Type text snippet"/>
          <ComboBoxItem Content="Favorite current song (Feishin)"/>
          <ComboBoxItem Content="Pad builtin action"/>
          <!-- Appended, never inserted: these positions are the wire format for
               TypeToIndex/IndexToType, so renumbering them would silently remap
               every binding already in profiles.json. -->
          <ComboBoxItem Content="Rewrite selection (local model)"/>
        </ComboBox>

        <TextBlock x:Name="TargetLabel" Style="{StaticResource SectionLabel}" Text="TARGET"/>
        <Grid x:Name="TargetRow">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBox x:Name="BindTarget" TextChanged="Bind_Changed"/>
          <Button Grid.Column="1" x:Name="BrowseBtn" Style="{StaticResource GhostBtn}" Content="…"
                  Padding="10,6" Margin="6,0,0,0" Click="Browse_Click"/>
        </Grid>

        <ComboBox x:Name="BindWindowOp" SelectionChanged="Bind_Changed" Visibility="Collapsed">
          <ComboBoxItem Content="Snap left"/>
          <ComboBoxItem Content="Snap right"/>
          <ComboBoxItem Content="Maximize"/>
          <ComboBoxItem Content="Minimize"/>
          <ComboBoxItem Content="Next monitor"/>
        </ComboBox>

        <StackPanel x:Name="ShortcutPanel" Visibility="Collapsed">
          <StackPanel Orientation="Horizontal" Margin="0,2,0,6">
            <CheckBox x:Name="ModCtrl"  Content="Ctrl"  Margin="0,0,10,0" Checked="Bind_Changed" Unchecked="Bind_Changed"/>
            <CheckBox x:Name="ModShift" Content="Shift" Margin="0,0,10,0" Checked="Bind_Changed" Unchecked="Bind_Changed"/>
            <CheckBox x:Name="ModAlt"   Content="Alt"   Margin="0,0,10,0" Checked="Bind_Changed" Unchecked="Bind_Changed"/>
            <CheckBox x:Name="ModWin"   Content="Win"   Checked="Bind_Changed" Unchecked="Bind_Changed"/>
          </StackPanel>
          <ComboBox x:Name="BindKeyCombo" SelectionChanged="Bind_Changed"/>
        </StackPanel>

        <ComboBox x:Name="BindMedia" SelectionChanged="Bind_Changed" Visibility="Collapsed"/>

        <!-- Populated live from the pad's own ACTION_LIB, never a local copy -->
        <StackPanel x:Name="PadActionPanel" Visibility="Collapsed">
          <ComboBox x:Name="BindPadAction" SelectionChanged="Bind_Changed"/>
          <TextBlock x:Name="PadActionHint" Margin="0,4,0,0" TextWrapping="Wrap"
                     Foreground="{StaticResource Muted}" FontSize="11"
                     Text="Runs on the pad itself — no host involvement."/>
        </StackPanel>

        <!-- "write" takes no target or arguments; the styles, the model and the preset
             the menu borrows are all configured in styles.json. -->
        <TextBlock x:Name="WriteHint" Visibility="Collapsed" Margin="0,8,0,0" TextWrapping="Wrap"
                   Foreground="{StaticResource Muted}" FontSize="11"
                   Text="Captures the current selection and opens the rewrite menu on the pad, then pastes back over the selection if you accept. Styles, model and the preset it borrows (writePreset) live in styles.json, which hot-reloads — no rebuild needed."/>

        <TextBlock x:Name="ArgsLabel" Style="{StaticResource SectionLabel}" Text="ARGUMENTS"/>
        <TextBox x:Name="BindArgs" TextChanged="Bind_Changed"/>
        <CheckBox x:Name="BindHidden" Content="Run hidden (no console window)" Margin="0,8,0,0"
                  Foreground="{StaticResource Ink}" Checked="Bind_Changed" Unchecked="Bind_Changed"/>

        <TextBlock Style="{StaticResource SectionLabel}" Text="LABEL ON PAD (≤ 8 chars)"/>
        <TextBox x:Name="BindLabel" MaxLength="8" TextChanged="Bind_Changed"/>
      </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- ── Bottom bar ──────────────────────────── -->
    <DockPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,14,0,0">
      <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryBtn}" Content="Save &amp; push to pad" Click="Save_Click"/>
      <Button DockPanel.Dock="Right" Style="{StaticResource GhostBtn}" Content="Revert" Margin="0,0,10,0" Click="Revert_Click"/>
      <TextBlock x:Name="Hint" Style="{StaticResource MutedText}" VerticalAlignment="Center"
                 Text="Saving writes profiles.json — labels and colors push to the pad instantly."/>
    </DockPanel>
  </Grid>
</Window>
