<Window x:Class="MacroPadDeck.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MacroPad Deck" Width="1000" Height="680" MinWidth="900" MinHeight="600"
        FontFamily="Segoe UI" FontSize="13" Icon="deck.ico"
        WindowStartupLocation="CenterScreen" SnapsToDevicePixels="True"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        WindowStyle="None" ResizeMode="CanResize"
        MaxHeight="{x:Static SystemParameters.MaximizedPrimaryScreenHeight}"
        MaxWidth="{x:Static SystemParameters.MaximizedPrimaryScreenWidth}">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <!-- "Void Deck". Every colour and control style lives in Theme.xaml, shared with
       the rewrite preview, so the two windows cannot drift apart again. -->
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Theme.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Window.Background>
    <StaticResource ResourceKey="Void"/>
  </Window.Background>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="42"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ================= Title bar ================= -->
    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
        <!-- The one warm light. Breathes while the pad is being looked for; holds
             steady once linked. Driven from code (LinkDot / LinkUp). -->
        <Grid Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center">
          <Ellipse Width="22" Height="22" Margin="-7" Fill="{StaticResource EmberHalo}"/>
          <Ellipse x:Name="LinkDot" Width="8" Height="8" Fill="{StaticResource Ember}"/>
        </Grid>
        <TextBlock Text="MacroPad Deck" Style="{StaticResource H1}" VerticalAlignment="Center"/>
        <TextBlock x:Name="LinkStatus" Foreground="{StaticResource Dim}" FontSize="11" Margin="12,1,0,0"
                   VerticalAlignment="Center" Text="connecting…"/>
        <!-- Keys | Face. Two views over one footer; Save acts on the visible one. -->
        <StackPanel Orientation="Horizontal" Margin="28,0,0,0" VerticalAlignment="Center">
          <Button x:Name="TabKeys" Style="{StaticResource GhostBtn}" Content="Keys" Padding="14,4"
                  WindowChrome.IsHitTestVisibleInChrome="True" Click="TabKeys_Click"/>
          <Button x:Name="TabFace" Style="{StaticResource GhostBtn}" Content="Face" Padding="14,4" Margin="6,0,0,0"
                  WindowChrome.IsHitTestVisibleInChrome="True" Click="TabFace_Click"/>
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
        <Button Content="&#xE921;" Style="{StaticResource Glyph}" Click="Minimise_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Minimise"/>
        <Button Content="&#xE8BB;" Style="{StaticResource Glyph}" Click="CloseBtn_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Close"/>
      </StackPanel>
    </Grid>

    <!-- ================= Face view ================= -->
    <!-- Rows are built in EditorWindow.Face.cs from face.json, so a trigger the
         firmware adds only needs a name in Protocol.PadTriggers. -->
    <Grid x:Name="FaceView" Grid.Row="1" Margin="18,6,18,0" Visibility="Collapsed">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="14"/>
        <ColumnDefinition Width="310"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{StaticResource Card}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="EVENTS → EMOTES" Style="{StaticResource H2}"/>
          <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,10"
                     Text="Pad events fire on the pad itself, PC or not. (PC) events come from this app. Chance 0 turns an event off; the cooldown is spent on every try, so a chance below 100 means 'sometimes'."/>
          <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="170"/>
              <ColumnDefinition Width="120"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="70"/>
              <ColumnDefinition Width="44"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{StaticResource SectionLabel}" Text="EVENT" Margin="0"/>
            <TextBlock Grid.Column="1" Style="{StaticResource SectionLabel}" Text="EMOTE" Margin="0"/>
            <TextBlock Grid.Column="2" Style="{StaticResource SectionLabel}" Text="CHANCE" Margin="0"/>
            <TextBlock Grid.Column="3" Style="{StaticResource SectionLabel}" Text="COOLDOWN" Margin="0"/>
          </Grid>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="FaceRules"/>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <Border Grid.Column="2" Style="{StaticResource Card}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <TextBlock Text="DANCE" Style="{StaticResource H2}"/>
            <DockPanel Margin="0,4,0,0">
              <TextBlock x:Name="DanceLevelOut" DockPanel.Dock="Right" Style="{StaticResource MonoMuted}"/>
              <TextBlock Style="{StaticResource SectionLabel}" Text="HOW MUCH IT DANCES" Margin="0"/>
            </DockPanel>
            <Slider x:Name="DanceLevel" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10"
                    IsSnapToTickEnabled="True" TickFrequency="5" ValueChanged="Dance_Changed"/>
            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                       Text="0 still · up to 30 a nod on the beat · up to 70 adds sway and tilt · above 70 side-steps, bounces and a headbang when the music is loud."/>
            <DockPanel Margin="0,14,0,0">
              <TextBlock x:Name="FlairOut" DockPanel.Dock="Right" Style="{StaticResource MonoMuted}"/>
              <TextBlock Style="{StaticResource SectionLabel}" Text="FLAIR EMOTE EVERY" Margin="0"/>
            </DockPanel>
            <Slider x:Name="FlairBars" Minimum="0" Maximum="16" SmallChange="1" LargeChange="4"
                    IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="Dance_Changed"/>
            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                       Text="While dancing, every N bars it may throw in the 'Dance flair' emote. Sliders preview live on the pad; Save keeps them."/>

            <TextBlock Text="TRY AN EMOTE" Style="{StaticResource H2}" Margin="0,22,0,6"/>
            <WrapPanel x:Name="EmoteButtons"/>
            <TextBlock x:Name="FacePadState" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,10,0,0"/>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- ================= Content ================= -->
    <Grid x:Name="KeysView" Grid.Row="1" Margin="18,6,18,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="230"/>
        <ColumnDefinition Width="14"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="14"/>
        <ColumnDefinition Width="310"/>
      </Grid.ColumnDefinitions>

      <!-- ==== Profiles ==== -->
      <Border Grid.Column="0" Style="{StaticResource Card}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="PROFILES" Style="{StaticResource H2}"/>
          <StackPanel DockPanel.Dock="Bottom">
            <TextBlock Style="{StaticResource SectionLabel}" Text="EYE COLOUR"/>
            <ItemsControl x:Name="EyeSwatches">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <TextBox x:Name="EyeColorBox" Width="84" TextChanged="EyeColor_Changed"/>
              <Button x:Name="EyePresetBtn" Style="{StaticResource GhostBtn}" Content="match preset"
                      Padding="10,5" Margin="6,0,0,0" FontSize="11" Click="EyePreset_Click"/>
            </StackPanel>
            <Button x:Name="AddProfileBtn" Style="{StaticResource GhostBtn}"
                    Content="+ Add profile" Margin="0,14,0,0" Click="AddProfile_Click"/>
          </StackPanel>
          <ListBox x:Name="ProfileList" Background="Transparent" BorderThickness="0"
                   ItemContainerStyle="{StaticResource ProfileRow}"
                   SelectionChanged="ProfileList_SelectionChanged" HorizontalContentAlignment="Stretch"/>
        </DockPanel>
      </Border>

      <!-- ==== Key grid ==== -->
      <Border Grid.Column="2" Style="{StaticResource Card}">
        <DockPanel>
          <!-- Name on its own row: preset + eight swatches + hex box already fill the
               card width, so sharing a row squeezed the name field to nothing. -->
          <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Style="{StaticResource H2}" Text="PROFILE NAME"/>
            <TextBox x:Name="ProfName" Width="240" HorizontalAlignment="Left" TextChanged="Meta_Changed"/>
          </StackPanel>
          <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
              <StackPanel Margin="0,0,14,0">
                <TextBlock Style="{StaticResource H2}" Text="PAD PRESET"/>
                <ComboBox x:Name="ProfPreset" Width="72" SelectionChanged="Meta_Changed"/>
              </StackPanel>
              <StackPanel>
                <TextBlock Style="{StaticResource H2}" Text="EYE / ACCENT COLOUR"/>
                <StackPanel Orientation="Horizontal">
                  <ItemsControl x:Name="Swatches" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                  </ItemsControl>
                  <TextBox x:Name="ProfColor" Width="78" Margin="6,0,0,0" TextChanged="Meta_Changed"/>
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Grid>

          <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Style="{StaticResource H2}" Text="AUTO-ACTIVATE FOR APPS · comma-separated exe names"/>
            <TextBox x:Name="ProfApps" TextChanged="Meta_Changed"/>
          </StackPanel>

          <Button DockPanel.Dock="Bottom" x:Name="DeleteProfileBtn" Style="{StaticResource GhostBtn}"
                  Content="Delete this profile" HorizontalAlignment="Left" Margin="0,12,0,0"
                  Click="DeleteProfile_Click"/>

          <UniformGrid x:Name="KeyGrid" Columns="4" Rows="3"/>
        </DockPanel>
      </Border>

      <!-- ==== Binding editor ==== -->
      <Border Grid.Column="4" Style="{StaticResource Card}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <TextBlock x:Name="BindTitle" FontSize="15" FontWeight="Light" Text="Select a key"/>
          <TextBlock Style="{StaticResource Hint}" Text="K9 is the pad's FN key — its tap can still carry an action." Margin="0,4,0,0" TextWrapping="Wrap"/>

          <TextBlock Style="{StaticResource SectionLabel}" Text="ACTION"/>
          <ComboBox x:Name="BindType" SelectionChanged="BindType_Changed">
            <ComboBoxItem Content="None (keep firmware key)"/>
            <ComboBoxItem Content="Focus or launch app"/>
            <ComboBoxItem Content="Open URL / file / folder"/>
            <ComboBoxItem Content="Run command"/>
            <ComboBoxItem Content="Window control"/>
            <ComboBoxItem Content="Keyboard shortcut"/>
            <ComboBoxItem Content="Media key"/>
            <ComboBoxItem Content="Type text snippet"/>
            <ComboBoxItem Content="Favorite current song (Feishin)"/>
            <ComboBoxItem Content="Pad builtin action"/>
            <!-- Appended, never inserted: these positions are the wire format for
                 TypeToIndex/IndexToType, so renumbering them would silently remap
                 every binding already in profiles.json. -->
            <ComboBoxItem Content="Rewrite selection (local model)"/>
          </ComboBox>

          <TextBlock x:Name="TargetLabel" Style="{StaticResource SectionLabel}" Text="TARGET"/>
          <Grid x:Name="TargetRow">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="BindTarget" TextChanged="Bind_Changed"/>
            <Button Grid.Column="1" x:Name="BrowseBtn" Style="{StaticResource GhostBtn}" Content="…"
                    Padding="10,5" Margin="6,0,0,0" Click="Browse_Click"/>
          </Grid>

          <ComboBox x:Name="BindWindowOp" SelectionChanged="Bind_Changed" Visibility="Collapsed">
            <ComboBoxItem Content="Snap left"/>
            <ComboBoxItem Content="Snap right"/>
            <ComboBoxItem Content="Maximize"/>
            <ComboBoxItem Content="Minimize"/>
            <ComboBoxItem Content="Next monitor"/>
          </ComboBox>

          <StackPanel x:Name="ShortcutPanel" Visibility="Collapsed">
            <!-- Recorder, not four checkboxes plus a list. The chips are the display of
                 _recMod/_recKey; the wire format (Mod bitmask + a Protocol.HidKeys name)
                 is unchanged, so profiles.json stays readable by older builds. -->
            <Border x:Name="ShortcutBox" Focusable="True" Background="{StaticResource Void}" CornerRadius="6"
                    BorderBrush="{StaticResource Hair}" BorderThickness="1"
                    Padding="10,7" Margin="0,2,0,0" Cursor="Hand"
                    PreviewKeyDown="ShortcutBox_PreviewKeyDown"
                    PreviewMouseLeftButtonDown="ShortcutBox_Click"
                    GotKeyboardFocus="ShortcutBox_FocusChanged"
                    LostKeyboardFocus="ShortcutBox_FocusChanged">
              <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostBtn}" Content="Clear"
                        Padding="8,3" Margin="8,0,0,0" FontSize="11" Click="ShortcutClear_Click"/>
                <TextBlock x:Name="ShortcutEmpty" DockPanel.Dock="Left" VerticalAlignment="Center"
                           Foreground="{StaticResource Muted}" FontSize="12"
                           Text="Click, then press a shortcut"/>
                <ItemsControl x:Name="ShortcutChips" VerticalAlignment="Center">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{StaticResource Raised}" BorderBrush="{StaticResource Hair}" BorderThickness="1"
                              CornerRadius="5" Padding="7,2" Margin="0,0,5,0">
                        <TextBlock Text="{Binding}" FontFamily="{StaticResource MonoFont}" FontSize="12"/>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </DockPanel>
            </Border>
            <TextBlock x:Name="ShortcutHint" Style="{StaticResource Hint}"
                       Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="Esc cancels without changing it. Clear removes the shortcut."/>
          </StackPanel>

          <ComboBox x:Name="BindMedia" SelectionChanged="Bind_Changed" Visibility="Collapsed"/>

          <!-- Populated live from the pad's own ACTION_LIB, never a local copy -->
          <StackPanel x:Name="PadActionPanel" Visibility="Collapsed">
            <ComboBox x:Name="BindPadAction" SelectionChanged="Bind_Changed"/>
            <TextBlock x:Name="PadActionHint" Margin="0,4,0,0" TextWrapping="Wrap" Style="{StaticResource Hint}"
                       Text="Runs on the pad itself — no host involvement."/>
          </StackPanel>

          <!-- "write" takes no target or arguments; the styles, the model and the preset
               the menu borrows are all configured in styles.json. -->
          <TextBlock x:Name="WriteHint" Visibility="Collapsed" Margin="0,8,0,0" TextWrapping="Wrap" Style="{StaticResource Hint}"
                     Text="Captures the current selection and opens the rewrite menu on the pad, then pastes back over the selection if you accept. Styles, model and the preset it borrows (writePreset) live in styles.json, which hot-reloads — no rebuild needed."/>

          <TextBlock x:Name="ArgsLabel" Style="{StaticResource SectionLabel}" Text="ARGUMENTS"/>
          <TextBox x:Name="BindArgs" TextChanged="Bind_Changed"/>
          <CheckBox x:Name="BindHidden" Content="Run hidden (no console window)" Margin="0,10,0,0"
                    Checked="Bind_Changed" Unchecked="Bind_Changed"/>

          <TextBlock Style="{StaticResource SectionLabel}" Text="LABEL ON PAD · ≤ 8 chars"/>
          <TextBox x:Name="BindLabel" MaxLength="8" TextChanged="Bind_Changed"/>
        </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- ================= Footer ================= -->
    <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Hair}" BorderThickness="0,1,0,0" Margin="0,14,0,0">
      <DockPanel Margin="18,10">
        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryBtn}" Content="Save &amp; push to pad" Click="Save_Click"/>
        <Button DockPanel.Dock="Right" Style="{StaticResource GhostBtn}" Content="Revert" Margin="0,0,10,0" Click="Revert_Click"/>
        <TextBlock x:Name="Hint" Style="{StaticResource MonoMuted}" VerticalAlignment="Center"
                   Text="Saving writes profiles.json — labels and colours push to the pad instantly."/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
